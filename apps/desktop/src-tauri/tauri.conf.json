{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhantomMirror",
  "version": "0.1.0",
  "identifier": "dev.phantommirror.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhantomMirror",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "PhantomMirror",
    "copyright": "© 2026 PhantomMirror",
    "category": "Utility",
    "shortDescription": "Multi-device phone screen mirroring for desktop",
    "longDescription": "PhantomMirror lets you mirror and control multiple Android devices and view iOS screens simultaneously on your PC or laptop. Connect via USB or WiFi.",
    "resources": {
      "../../../tools/uxplay": "tools/uxplay",
      "../../../tools/scrcpy-server": "tools/scrcpy-server"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "compression": "lzma",
        "startMenuFolder": "PhantomMirror"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}
